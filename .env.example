# Copy this file to .env (it is never committed)
TYPESAFE_API_KEY=

# Optional — who you are, to tell issued invoices from received ones
OWNER=My Company / My Name

# Optional — language of folder names and messages: en, es, fr, it (default: system language)
LANGUAGE=

# Optional — directory to tidy instead of the one that contains this project (e.g. ~/Downloads)
ROOT_DIR=

# Optional — where screenshots go: a folder name inside the Desktop or any path (~/Pictures/Screenshots)
SCREENSHOTS_DIR=

# Optional — rename the other two special folders
REVIEW_DIR=
TO_DELETE_DIR=

# Optional — comma-separated Desktop files or folders to leave alone and never offer as a destination
IGNORE=
